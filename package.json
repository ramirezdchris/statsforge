{
  "name": "statsforge",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "private": true,
  "description": "Sistema local de análisis estadístico deportivo con flujo de solicitudes",
  "scripts": {
    "api:dev": "pnpm --filter api dev",
    "api:build": "pnpm --filter api build",
    "api:test": "pnpm --filter api test",
    "web:dev": "pnpm --filter web start",
    "web:build": "pnpm --filter web build",
    "web:test": "pnpm --filter web test",
    "build": "pnpm --recursive --filter \"./apps/*\" build",
    "test": "pnpm --recursive --filter \"./apps/*\" test",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
