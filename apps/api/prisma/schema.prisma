// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum RequestStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
  FAILED
}

enum DeliveryChannel {
  APP
  TELEGRAM
  BOTH
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  role               Role      @default(VIEWER)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  telegramChatId     String?
  telegramUsername   String?
  invitedById        String?
  invitedAt          DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  invitedBy   User?      @relation("Invitations", fields: [invitedById], references: [id])
  invitations User[]     @relation("Invitations")
  sessions    Session[]
  requests    AnalysisRequest[] @relation("Requester")
  reviews     AnalysisRequest[] @relation("Reviewer")
  auditLogs   AuditLog[]
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SystemConfig {
  key       String   @id
  value     String
  category  String   @default("general")
  updatedAt DateTime @updatedAt
}

model League {
  id        Int      @id
  name      String
  country   String
  type      String?
  logoUrl   String?
  flagUrl   String?
  isEnabled Boolean  @default(true)
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams Team[]
}

model Team {
  id        Int      @id
  leagueId  Int?
  name      String
  code      String?
  country   String?
  logoUrl   String?
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league League? @relation(fields: [leagueId], references: [id])

  @@index([leagueId])
}

model Market {
  key         String   @id
  label       String
  description String?
  category    String
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiCache {
  key          String    @id
  provider    String    @default("api-football")
  endpoint     String
  queryJson    String
  responseJson String
  expiresAt    DateTime?
  fetchedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([endpoint])
  @@index([expiresAt])
}

model AnalysisRequest {
  id              String          @id @default(cuid())
  requesterId     String
  reviewerId      String?
  status          RequestStatus   @default(PENDING)
  basketJson      String
  defaultMarkets  String
  historyDepth    Int             @default(10)
  includeExcel    Boolean         @default(false)
  deliveryChannel DeliveryChannel @default(APP)
  message         String?
  rejectionReason String?
  estimatedCalls  Int?
  actualCalls     Int?
  resultJson      String?
  createdAt       DateTime        @default(now())
  reviewedAt      DateTime?
  completedAt     DateTime?
  updatedAt       DateTime        @updatedAt

  requester User  @relation("Requester", fields: [requesterId], references: [id])
  reviewer  User? @relation("Reviewer", fields: [reviewerId], references: [id])

  @@index([requesterId])
  @@index([reviewerId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  metadata  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
}
