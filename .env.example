# ==========================================
# StatsForge - Variables de entorno
# ==========================================
# Copia este archivo a .env y llena los valores reales
# NUNCA commitees el .env real

# ---- Base de datos ----
DATABASE_URL="file:./prisma/dev.db"

# ---- JWT ----
# Genera un secret largo random con: openssl rand -base64 48
JWT_SECRET="cambiar-esto-por-string-random-largo-de-al-menos-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ---- Admin inicial (solo primer seed) ----
ADMIN_EMAIL="admin@statsforge.local"
ADMIN_PASSWORD="cambiar-esto-al-primer-login"
ADMIN_NAME="Admin"

# ---- API-Football (Fase 2+) ----
API_FOOTBALL_KEY=""
API_FOOTBALL_HOST="v3.football.api-sports.io"
API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"

# ---- Telegram (Fase 4+) ----
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# ---- Redis (Fase 5+) ----
REDIS_URL="redis://localhost:6379"

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- CORS ----
CORS_ORIGIN="http://localhost:4200,http://127.0.0.1:4200"

# ---- Frontend build/runtime ----
# URL publica del backend cuando compiles el frontend para deploy.
WEB_API_BASE_URL="https://tu-api-publica.example.com"
